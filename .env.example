# ─────────────────────────────────────────────
# Docker Compose (docker compose up)
# ─────────────────────────────────────────────

# PostgreSQL credentials (used both inside compose and for local dev)
POSTGRES_USER=buh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buh

# Host port the DB container is exposed on
DB_HOST_PORT=5433

# Host port the app container is exposed on
APP_HOST_PORT=8081

# Address the HTTP server listens on inside the container
BUH_ADDR=:8081

# ─────────────────────────────────────────────
# Local development (without Docker Compose)
# ─────────────────────────────────────────────

# PostgreSQL connection string for running the binary directly
# (inside docker-compose the URL is composed automatically from POSTGRES_* vars)
# BUH_DATABASE_URL=postgres://buh:buh@localhost:5432/buh?sslmode=disable

# ─────────────────────────────────────────────
# Session keys (required – compose will fail without them)
# ─────────────────────────────────────────────

# HMAC key for signing session cookies (32+ random bytes, base64-encoded)
# Generate with: openssl rand -base64 32
BUH_SESSION_HASH_KEY=

# AES key for encrypting session cookie values (16, 24, or 32 random bytes, base64-encoded)
# Generate with: openssl rand -base64 32
BUH_SESSION_BLOCK_KEY=