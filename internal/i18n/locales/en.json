  "pausal_limit_info.title": {
    "other": "Flat-rate Income Limit"
  },
  "pausal_limit_info.subtitle": {
    "other": "What the flat-rate limit means and what happens if you exceed it"
  },
  "pausal_limit_info.limit_q": {
    "other": "What is the limit?"
  },
  "pausal_limit_info.limit_intro": {
    "other": "Flat-rate entrepreneurs are exempt from full business bookkeeping, but only up to a certain annual income:"
  },
  "pausal_limit_info.until_2026": {
    "other": "RSD 6,000,000"
  },
  "pausal_limit_info.limit_note": {
    "other": "The limit is based on turnover — total income from goods and service sales in the calendar year."
  },
  "pausal_limit_info.consequences_q": {
    "other": "What happens if you exceed the limit?"
  },
  "pausal_limit_info.consequences_intro": {
    "other": "If your annual turnover exceeds the prescribed amount, you lose the right to flat-rate taxation and switch to actual income taxation. In practice this means:"
  },
  "pausal_limit_info.con_bookkeeping": {
    "other": "Mandatory business records (KEP, business account, invoices)"
  },
  "pausal_limit_info.con_tax_payments": {
    "other": "Quarterly advance tax payments based on actual income"
  },
  "pausal_limit_info.con_tax_return": {
    "other": "Filing an annual tax return with final settlement"
  },
  "pausal_limit_info.con_burden": {
    "other": "Significantly higher administrative burden and accounting costs"
  },
  "pausal_limit_info.consequences_note": {
    "other": "Switching from flat-rate to actual income taxation can be financially unfavorable — especially if you haven't planned expenses in advance."
  },
  "pausal_limit_info.planning_q": {
    "other": "What can you do?"
  },
  "pausal_limit_info.planning_intro": {
    "other": "There are various legal options for expense planning before reaching the limit — equipment purchases, investments, prepaid services, and more."
  },
  "pausal_limit_info.planning_rec": {
    "other": "Consult a qualified accountant early — they will recommend a solution tailored to your specific situation."
  },
  "vat_limit_info.title": {
    "other": "VAT Registration Threshold"
  },
  "vat_limit_info.subtitle": {
    "other": "What the VAT threshold means and what happens if you exceed it"
  },
  "vat_limit_info.limit_q": {
    "other": "What is the threshold?"
  },
  "vat_limit_info.limit_intro": {
    "other": "An entrepreneur must register for VAT if their total turnover in the last 12 months has exceeded:"
  },
  "vat_limit_info.current_limit": {
    "other": "Current: RSD 8,000,000"
  },
  "vat_limit_info.limit_note": {
    "other": "Unlike the flat-rate limit (calendar year), the VAT threshold is calculated on a rolling window — turnover in the last 365 days."
  },
  "vat_limit_info.consequences_q": {
    "other": "What happens if you exceed the threshold?"
  },
  "vat_limit_info.consequences_intro": {
    "other": "If your turnover in the last 12 months exceeds RSD 8,000,000, you must file a VAT registration request. In practice this means:"
  },
  "vat_limit_info.con_calculation": {
    "other": "Mandatory VAT calculation on every invoice you issue"
  },
  "vat_limit_info.con_filing": {
    "other": "Filing monthly or quarterly VAT returns"
  },
  "vat_limit_info.con_credit": {
    "other": "Right to deduct input tax (VAT on purchases)"
  },
  "vat_limit_info.con_burden": {
    "other": "Significantly higher administrative burden and accounting costs"
  },
  "vat_limit_info.con_pricing": {
    "other": "VAT registration changes how you do business — prices charged to clients must include VAT, or your margin shrinks."
  },
  "vat_limit_info.planning_q": {
    "other": "What can you do?"
  },
  "vat_limit_info.planning_intro": {
    "other": "There are various legal options for expense planning before reaching the threshold."
  },
  "vat_limit_info.planning_rec": {
    "other": "Consult a qualified accountant early — they will recommend a solution tailored to your specific situation."
  },
